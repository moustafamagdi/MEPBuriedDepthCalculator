<Window x:Class="MEPBuriedDepthCalculator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Buried Depth Calculator (Revit 2024)" Height="520" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="MEP Buried Depth Calculator" FontSize="18" FontWeight="Bold" Foreground="#FF1F4E79" Margin="0,0,0,15"/>

        <!-- Selection Mode -->
        <GroupBox Grid.Row="1" Header="Element Selection Mode" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <RadioButton Content="Current Selection" IsChecked="{Binding IsCurrentSelection}" Margin="0,2"/>
                <RadioButton Content="Manually Picked" IsChecked="{Binding IsPickElements}" Margin="0,2"/>
                <RadioButton Content="Current View" IsChecked="{Binding IsCurrentView}" Margin="0,2"/>
                <RadioButton Content="Entire Model" IsChecked="{Binding IsEntireModel}" Margin="0,2"/>
            </StackPanel>
        </GroupBox>

        <!-- Revit Link Selection -->
        <GroupBox Grid.Row="2" Header="Finished Ground Revit Link" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding AvailableLinks}" SelectedItem="{Binding SelectedLink}" DisplayMemberPath="Name" Height="26" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="Refresh Links" Command="{Binding RefreshLinksCommand}" Width="90" Margin="10,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Selection Actions -->
        <GroupBox Grid.Row="3" Header="Manual Selection" Padding="10" Margin="0,0,0,10">
            <Button Content="Pick Elements from Revit" Command="{Binding PickElementsCommand}" Height="30"/>
        </GroupBox>

        <!-- Shared Parameters Status -->
        <GroupBox Grid.Row="4" Header="Shared Parameters Status" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ParameterStatusText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="Ensure Parameters" Command="{Binding EnsureParametersCommand}" Width="130"/>
            </Grid>
        </GroupBox>

        <!-- Run Button -->
        <Button Grid.Row="5" Content="Calculate &amp; Update Depths" Command="{Binding CalculateCommand}" Height="35" Background="#FF1F4E79" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <!-- Summary Results -->
        <GroupBox Grid.Row="6" Header="Execution Summary" Padding="10">
            <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" VerticalAlignment="Top"/>
        </GroupBox>
    </Grid>
</Window>
